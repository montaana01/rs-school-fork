{
  "name": "decision-making-tool",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "stylelint": "stylelint '**/*.{css,scss}'",
    "stylelint:fix": "stylelint '**/*.{css,scss}' --fix",
    "prepare": "cd .. && husky ./decision-making-tool/.husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "commitlint": "^19.8.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-unicorn": "^57.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "sass": "^1.85.1",
    "stylelint": "^16.15.0",
    "stylelint-config-clean-order": "^7.0.0",
    "stylelint-config-standard": "^37.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "lint-staged": {
    "decision-making-tool/**/*.ts": "npx eslint --config ./decision-making-tool/eslint.config.mjs --fix",
    "decision-making-tool/**/*.{css,scss}": "npx stylelint --fix",
    "decision-making-tool/**/*.{ts,css,scss}": "npx prettier --write"
  },

  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
